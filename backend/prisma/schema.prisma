datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Patient {
  id           String        @id @default(uuid())
  phoneNumber  String        @unique
  fullName     String?
  fileNumber   String?       @unique
  isVerified   Boolean       @default(false)
  chatStatus   String        @default("BOT") // "BOT", "PENDING_AGENT", "AGENT_ACTIVE"
  assignedTo   String?       // Doctor or Agent name/ID
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  messages     MessageLog[]

}

model Appointment {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorName  String
  specialty   String
  servicePrice String   @default("KSh 0")
  consultationFee String @default("KSh 1,000")
  slotTime    DateTime
  status      String   @default("CONFIRMED")
  createdAt   DateTime @default(now())
}

model MessageLog {
  id        String   @id @default(uuid())
  whatsappMessageId String? @unique
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])
  sender    String   
  body      String
  timestamp DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}