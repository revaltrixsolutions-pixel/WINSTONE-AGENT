generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id                String        @id @default(uuid())
  phoneNumber       String        @unique
  fullName          String?
  fileNumber        String?       @unique
  isVerified        Boolean       @default(false)
  chatStatus        String        @default("BOT")
  assignedTo        String?
  agentLastActiveAt DateTime?
  createdAt         DateTime      @default(now())
  appointments      Appointment[]
  messages          MessageLog[]
}

model Appointment {
  id              String                @id @default(uuid())
  patientId       String
  doctorName      String
  specialty       String
  servicePrice    String                @default("KSh 0")
  consultationFee String                @default("KSh 1,000")
  slotTime        DateTime
  status          String                @default("CONFIRMED")
  createdAt       DateTime              @default(now())
  patient         Patient               @relation(fields: [patientId], references: [id])
  followUps       AppointmentFollowUp[]
  reminders       ReminderDelivery[]
}

model AppointmentFollowUp {
  id            String      @id @default(uuid())
  appointmentId String
  authorId      String
  authorName    String
  note          String
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model ReminderDelivery {
  id            String      @id @default(uuid())
  appointmentId String
  kind          String
  recipientType String
  sentAt        DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind, recipientType])
  @@index([recipientType, sentAt])
}

model MessageLog {
  id                String   @id @default(uuid())
  whatsappMessageId String?  @unique
  patientId         String?
  sender            String
  body              String
  timestamp         DateTime @default(now())
  patient           Patient? @relation(fields: [patientId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STAFF")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
